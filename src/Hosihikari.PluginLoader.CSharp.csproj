<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hosihikari.PluginLoader.CSharp</RootNamespace>
    <AssemblyName>Hosihikari.PluginLoader.CSharp</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- 它本身要作为一个插件包分发，包里的依赖必须跟着构建输出走。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <!-- 内容寻址与产物校验和都用 xxhash。 -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
  </ItemGroup>

  <!-- 契约来自另一个仓，两种拿法二选一。 -->
  <ItemGroup Condition="Exists('../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <ProjectReference Include="../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Plugin.Abstractions" Version="[3.0.0]" />
  </ItemGroup>

</Project>
