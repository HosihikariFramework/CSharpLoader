<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hosihikari.PluginLoader.CSharp.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <ProjectReference Include="../src/Hosihikari.PluginLoader.CSharp.csproj" />
    <ProjectReference Include="../test/PrivateDependency/PrivateDependency.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../test/OverlapV1/OverlapV1.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../test/OverlapV2/OverlapV2.csproj" ReferenceOutputAssembly="false" />
    <!-- 验证宿主借核心的 PluginManager；并列 checkout 才有。 -->
    <ProjectReference Include="../../Hosihikari.PluginManager/src/Hosihikari.PluginManager.csproj"
                      Condition="Exists('../../Hosihikari.PluginManager/src/Hosihikari.PluginManager.csproj')" />
  </ItemGroup>

</Project>
